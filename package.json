{
  "name": "dsh-lifecycle-cache-cleaner",
  "version": "0.8.1",
  "description": "DSH 本地 Agent 的 KV cache 生命周期管理：溢出闸门 + 工作日志固化 + 统一清理闸门（探测不到部署就不清理）+ 工作区记忆孤儿归档",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cleaner.js": "./cleaner.js",
    "./session-deleter.js": "./session-deleter.js",
    "./overflow-guard.js": "./overflow-guard.js",
    "./raw-trace.js": "./raw-trace.js",
    "./state.js": "./state.js",
    "./worklog.js": "./worklog.js",
    "./lib/*": "./lib/*",
    "./adapters/*": "./adapters/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "cleaner.js",
    "session-deleter.js",
    "overflow-guard.js",
    "raw-trace.js",
    "state.js",
    "worklog.js",
    "lib/",
    "adapters/",
    "docs/"
  ],
  "scripts": {
    "test": "node --test",
    "test:gate": "node --test test/release-gate.test.js",
    "test:seam": "node --test test/compaction-seam.test.js",
    "test:whalebone": "node --test test/v7-probe-ownership.test.js test/v8-real-release.test.js test/v9-probe-failure.test.js test/v10-concurrency.test.js test/v11-workspace-orphan.test.js"
  },
  "keywords": [
    "dsh",
    "kv-cache",
    "ollama",
    "llama.cpp",
    "vram",
    "context-compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccr-wer/dsh-Lifecycle-Cache-Cleaner.git"
  },
  "homepage": "https://github.com/ccr-wer/dsh-Lifecycle-Cache-Cleaner#readme",
  "bugs": {
    "url": "https://github.com/ccr-wer/dsh-Lifecycle-Cache-Cleaner/issues"
  },
  "license": "MIT"
}
